{
    "compilerOptions": {
      // Basic compiler options
      // ES2022 is a floor the emitted code genuinely requires, not a preference: the sources use
      // `static #` private fields (ES2022 syntax), `Object.hasOwn` and `Error`'s `cause` option
      // (ES2022 runtime APIs, which no target setting can transpile away). Pinned rather than
      // `esnext`, which states no contract at all because it drifts with every TypeScript release.
      "target": "ES2022", // Set the target JavaScript version
      "module": "ESNext", // Set the module system to ES modules
      "strict": true, // Enable all strict type checking options
      "esModuleInterop": true, // Allow emit ES modules and JSX files into ES modules
      "outDir": "./dist", // Output directory for compiled files
      "rootDir": "./src", // Root directory for source files
      "declaration": true, // Generate declaration files
      "allowJs": true, // Allow JavaScript files
      "declarationMap": true, // "Go to Definition" in VSCode
      "moduleResolution": "node"
    },
    "include": [
      "./src/**/*"
    ],
    "exclude": [
      "**/node_modules/**", // Exclude the yarn pnp package directory from being included
      "**/node_modules/**/*", // Recursively exclude all files within the node_modules directory, including under the .yarn folder
      ".yarn/**/*",
      "**/*.ts",
      "**/*.stories.*",
      "./src/stories/**/*",
      "**/*.test.*",
      "./src/__tests__/**/*",
      "./src/__fixtures__/**/*"
    ]
}
