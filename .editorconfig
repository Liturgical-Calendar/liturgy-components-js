# EditorConfig for @liturgical-calendar/components-js.
#
# This is the "get it right live" half of the JavaScript formatting story: prettier (see
# .prettierrc and the "JavaScript" section under Code Standards in CLAUDE.md) enforces the
# house style — 4-space indent, single quotes — after the fact, via `yarn format:js` and in CI.
# This file gets an editor to the same indentation before the fact, so a contributor's editor
# doesn't fight the formatter.
#
# `end_of_line = lf` is the repo-wide convention, and since issue #84 it is enforced rather than
# merely stated: `.gitattributes` carries `* text=auto eol=lf`, so git normalizes on checkin and
# no editor, script or platform default can reintroduce CRLF. The seven files that carried it
# were renormalized in one dedicated commit at that time.
#
# This file remains the "get it right live" half — git normalizes on the way in, an editor
# following this gets it right before that — but it is no longer the only line of defence, which
# is what it used to be and could not sustain.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.js]
indent_style = space
indent_size = 4
