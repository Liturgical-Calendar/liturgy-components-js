{
  // Used only by `yarn lint:dts` (see package.json) to verify that the declaration files in
  // `dist/` type-check under `strict` for a downstream consumer. It is deliberately isolated
  // from tsconfig.json: that config compiles `src/` with `checkJs` off, so it never validates
  // what actually ends up in the emitted `.d.ts` files. This config starts from `dist/index.d.ts`
  // instead and sets its own `target`/`lib` so a consumer's default compiler options (which we
  // cannot control) are not what determines whether the check passes.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "esModuleInterop": true
  },
  // `type-fixtures/` holds compile-time assertions about the emitted declarations
  // that no runtime test can reach — see its own file comment. Listed here rather
  // than in tsconfig.json so the fixtures are checked against `dist/` as a consumer
  // sees it, and never reach the build.
  "files": ["dist/index.d.ts", "type-fixtures/dts-consumer.ts"]
}
