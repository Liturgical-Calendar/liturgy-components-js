/.storybook/
/src/stories/
/src/__tests__/
/src/__fixtures__/
/storybook-static/
/.vscode/
/examples/
/.github/
.pnp.*
.gitignore
.npmignore
# Globbed rather than named: `tsconfig.dts-check.json` was added without this
# file being updated and duly shipped in 2.0.0. A pattern covers the next one.
tsconfig*.json
tsconfig.tsbuildinfo
yarn.lock
.env*
docker-compose.yml
Dockerfile
Dockerfile.dockerignore
*.tgz
CLAUDE.md
take-screenshot.mjs
/docs/

# Tooling configuration. It governs how this repository is developed and means
# nothing inside a consumer's node_modules.
.editorconfig
.git-blame-ignore-revs
.markdownlint.yml
.prettierrc
.prettierignore

# npm reads .gitignore only when there is no .npmignore, so every pattern in
# .gitignore that could match a file left in the working tree has to be
# repeated here or it fails open. `debug-storybook.log` is untracked, ignored
# by git, and shipped in 2.0.0 for exactly that reason.
*storybook.log
